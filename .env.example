# ===== Backend environment variables =====

# Required: Groq API key for the AI report
# Get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: SerpAPI key for product images + buying links
# Get 100 free searches/month at https://serpapi.com
# If omitted, the app still works but shows no product cards.
SERPAPI_KEY=your_serpapi_key_here
