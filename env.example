# ===== Backend environment variables =====

# Required: Groq API key for the AI report
# Get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Required: SerpAPI key for web search data, product images + buying links
# Powers the market analysis (web result count, top pages, product cards).
# Get 100 free searches/month at https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here
